{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;5;61m  ╭──────────────────────...\u001b[0m"
        },
        {
            "type": "title",
            "format": "\u001b[38;5;61m  │\u001b[0m  \u001b[1;38;5;183m{user-name}\u001b[0m\u001b[38;5;245m @ \u001b[0m\u001b[1;38;5;183m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;61m  ├──────────────────────...\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;110m  os    \u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;110m  kernel\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;217m  shell \u001b[0m"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;217m  term  \u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;115m  wm    \u001b[0m"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;152m  up    \u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;152m  pkgs  \u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;61m  ├──────────────────────...\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;61m  │\u001b[0m  \u001b[38;5;61m●\u001b[0m \u001b[38;5;63m●\u001b[0m \u001b[38;5;110m●\u001b[0m \u001b[38;5;217m●\u001b[0m \u001b[38;5;115m●\u001b[0m \u001b[38;5;222m●\u001b[0m \u001b[38;5;152m●\u001b[0m \u001b[38;5;183m●\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;61m  ╰──────────────────────...\u001b[0m"
        },
        "break"
    ]
}