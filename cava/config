# /* matugen template - colors-cava */

[general]
; mode = normal
; framerate = 60
; autosens = 1
; overshoot = 20
; sensitivity = 100
; bars = 0
; bar_width = 2
; bar_spacing = 1
; bar_height = 32

[input]
 method = pulse
 source = auto
 method = pipewire
 source = auto

[output]
; method = noncurses
; orientation = bottom

[color]
# for matugen
gradient = 1
gradient_count = 8
gradient_color_1 = '#1e100f'
gradient_color_2 = '#ffd4b6'
gradient_color_3 = '#ba8470'
gradient_color_4 = '#bf8354'
gradient_color_5 = '#ffffff'
gradient_color_6 = '#000000'
gradient_color_7 = '#3e1d00'
gradient_color_8 = '#f8dcda'

[smoothing]
; integral = 77
; monstercat = 0
; waves = 0
; gravity = 100
; noise_reduction = 77

[eq]
; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble
