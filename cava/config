# /* matugen template - colors-cava */

[general]
; mode = normal
; framerate = 60
; autosens = 1
; overshoot = 20
; sensitivity = 100
; bars = 0
; bar_width = 2
; bar_spacing = 1
; bar_height = 32

[input]
 method = pulse
 source = auto
 method = pipewire
 source = auto

[output]
; method = noncurses
; orientation = bottom

[color]
# for matugen
gradient = 1
gradient_count = 8
gradient_color_1 = '#0f1417'
gradient_color_2 = '#c8c2ea'
gradient_color_3 = '#364954'
gradient_color_4 = '#474364'
gradient_color_5 = '#dfe3e7'
gradient_color_6 = '#c1e8ff'
gradient_color_7 = '#302c4c'
gradient_color_8 = '#dfe3e7'

[smoothing]
; integral = 77
; monstercat = 0
; waves = 0
; gravity = 100
; noise_reduction = 77

[eq]
; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble
