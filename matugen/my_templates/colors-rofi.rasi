/* ---- 💫 https://github.com/JaKooLit 💫 ---- */  
/* matugen template - colors-rofi */

* {
active-background: {{colors.on_primary_container.default.hex}};
active-foreground: {{colors.on_background.default.hex}};
normal-background: {{colors.background.default.hex}};
normal-foreground: {{colors.on_background.default.hex}};
urgent-background: {{colors.on_tertiary.default.hex}};
urgent-foreground: {{colors.on_background.default.hex}};

alternate-active-background: {{colors.on_secondary_container.default.hex}};
alternate-active-foreground: {{colors.on_background.default.hex}};
alternate-normal-background: {{colors.background.default.hex}};
alternate-normal-foreground: {{colors.on_background.default.hex}};
alternate-urgent-background: {{colors.background.default.hex}};
alternate-urgent-foreground: {{colors.on_background.default.hex}};

selected-active-background: {{colors.on_tertiary.default.hex}};
selected-active-foreground: {{colors.on_background.default.hex}};
selected-normal-background: {{colors.on_tertiary.default.hex}};
selected-normal-foreground: {{colors.on_background.default.hex}};
selected-urgent-background: {{colors.on_primary_container.default.hex}};
selected-urgent-foreground: {{colors.on_background.default.hex}};

background-color: {{colors.background.default.hex}};
background: rgba(0,0,0,0.7);
foreground: {{colors.on_background.default.hex}};
border-color: {{colors.on_primary_container.default.hex}};

color0: {{colors.surface.default.hex}};
color1: {{colors.error.default.hex}};
color2: {{colors.tertiary.default.hex}};
color3: {{colors.secondary_container.default.hex}};
color4: {{colors.primary.default.hex}};
color5: {{colors.tertiary_container.default.hex}};
color6: {{colors.secondary.default.hex}};
color7: {{colors.on_surface.default.hex}};
color8: {{colors.surface_variant.default.hex}};
color9: {{colors.error_container.default.hex}};
color10: {{colors.on_tertiary_container.default.hex}};
color11: {{colors.on_secondary_container.default.hex}};
color12: {{colors.on_primary_container.default.hex}};
color13: {{colors.on_tertiary.default.hex}};
color14: {{colors.on_secondary.default.hex}};
color15: {{colors.on_background.default.hex}};
}
